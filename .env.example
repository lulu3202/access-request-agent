# Pick ONE way to reach Claude.

# Option A: Vercel AI Gateway (used when this is set)
AI_GATEWAY_API_KEY=

# Option B: Anthropic API directly (used when AI_GATEWAY_API_KEY is empty)
ANTHROPIC_API_KEY=

# Optional model override.
# Gateway default: anthropic/claude-sonnet-5.5   Direct default: claude-sonnet-5-5
ANTHROPIC_MODEL=

# Phoenix (local, open source). Run: uvx --python 3.12 --from arize-phoenix==20.26.1 phoenix serve
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
